{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": ["."],
  "graphs": {
    "supervisor": "./app/graph.py:supervisor_graph"
  },
  "env": ".env",
  "dockerfile_lines": [
    "RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && rm -rf /var/lib/apt/lists/*",
    "ENV PYTHONPATH=\"/deps/planifica-langchain/app:/deps/planifica-langchain\""
  ],
  "auth": {
    "path": "./app/auth/auth_handler.py:auth",
    "openapi": {
      "securitySchemes": {
        "cookieAuth": {
          "type": "apiKey",
          "in": "cookie",
          "name": "access_token",
          "description": "Cookie HTTP segura (HttpOnly, SameSite=Lax, Secure) que contiene el Access Token JWT de sesión (expiración 5 min)"
        }
      },
      "security": [
        { "cookieAuth": [] }
      ]
    }
  },
  "http": {
    "app": "./app/server.py:app",
    "enable_custom_route_auth": true,
    "cors": {
      "allow_origins": ["https://app.planifica.study"],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Content-Type", "Authorization", "Cookie"],
      "allow_credentials": true,
      "max_age": 600
    }
  }
}
